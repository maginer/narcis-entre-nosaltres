{
  "name": "narcis-entre-nosaltres",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Autotest «Com de narcisista ets?» del Treball de Recerca «Narcís entre nosaltres»",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",

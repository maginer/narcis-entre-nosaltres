---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Brief from '../components/Brief.astro';
import Stepper from '../components/Stepper.astro';
import Result from '../components/Result.astro';
import Explain from '../components/Explain.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';

const title = 'Com de narcisista ets? · Narcís entre nosaltres';
const description =
  'Autotest de 21 ítems sobre el narcisisme com a tret de personalitat, inspirat en les set dimensions del NPI. Material del Treball de Recerca «Narcís entre nosaltres» (INS Corbera). No és un diagnòstic.';
---

<Base title={title} description={description}>
  <div class="topbar" aria-hidden="true"><i id="topfill"></i></div>
  <div class="wrap">
    <Header />
    <Hero />
    <Brief />
    <Stepper />
  </div>
  <Result />
  <div class="wrap">
    <Explain />
    <About />
    <Footer />
  </div>
  <script>
    import '../scripts/app';
  </script>
</Base>
